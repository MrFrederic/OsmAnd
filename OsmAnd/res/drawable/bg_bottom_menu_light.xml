<?xml version="1.0" encoding="utf-8"?>
<!-- M3 sheet over the map: rounded top corners; the shadow comes from the view elevation so it
     follows the corners. The inset keeps the space the former shadow image reserved. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetTop="@dimen/bottom_sheet_shadow_inset">
    <shape>
        <solid android:color="@color/list_background_color_light" />
        <corners
            android:topLeftRadius="@dimen/bottom_sheet_corner_radius"
            android:topRightRadius="@dimen/bottom_sheet_corner_radius" />
    </shape>
</inset>
