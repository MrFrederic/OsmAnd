<?xml version="1.0" encoding="utf-8" standalone="no"?>
<resources xmlns:android="http://schemas.android.com/apk/res/android">

	<!-- Single source of truth for the Material 3 colour roles. Both the app-wide themes
	     (OsmandLightTheme / OsmandDarkTheme) and the Material screens' themes
	     (OsmandMaterialLightTheme / OsmandMaterialDarkTheme) inherit from these, so a role
	     changed in colors.xml reaches every screen. -->

	<style name="Base.Theme.OsmAnd.Light" parent="Theme.Material3Expressive.Light">
		<item name="colorPrimary">@color/primary_light</item>
		<item name="colorOnPrimary">@color/on_primary_light</item>
		<item name="colorPrimaryContainer">@color/primary_container_light</item>
		<item name="colorOnPrimaryContainer">@color/on_primary_container_light</item>
		<item name="colorPrimaryInverse">@color/primary_inverse_light</item>
		<item name="colorSecondary">@color/secondary_light</item>
		<item name="colorOnSecondary">@color/on_secondary_light</item>
		<item name="colorSecondaryContainer">@color/secondary_container_light</item>
		<item name="colorOnSecondaryContainer">@color/on_secondary_container_light</item>
		<item name="colorTertiary">@color/tertiary_light</item>
		<item name="colorOnTertiary">@color/on_tertiary_light</item>
		<item name="colorTertiaryContainer">@color/tertiary_container_light</item>
		<item name="colorOnTertiaryContainer">@color/on_tertiary_container_light</item>
		<item name="colorError">@color/error_light</item>
		<item name="colorOnError">@color/on_error_light</item>
		<item name="colorErrorContainer">@color/error_container_light</item>
		<item name="colorOnErrorContainer">@color/on_error_container_light</item>
		<item name="android:colorBackground">@color/surface_light</item>
		<item name="colorOnBackground">@color/on_surface_light</item>
		<item name="colorSurface">@color/surface_light</item>
		<item name="colorOnSurface">@color/on_surface_light</item>
		<item name="colorSurfaceVariant">@color/surface_variant_light</item>
		<item name="colorOnSurfaceVariant">@color/on_surface_variant_light</item>
		<item name="colorSurfaceDim">@color/surface_dim_light</item>
		<item name="colorSurfaceBright">@color/surface_bright_light</item>
		<item name="colorSurfaceContainerLowest">@color/surface_container_lowest_light</item>
		<item name="colorSurfaceContainerLow">@color/surface_container_low_light</item>
		<item name="colorSurfaceContainer">@color/surface_container_light</item>
		<item name="colorSurfaceContainerHigh">@color/surface_container_high_light</item>
		<item name="colorSurfaceContainerHighest">@color/surface_container_highest_light</item>
		<item name="colorSurfaceInverse">@color/surface_inverse_light</item>
		<item name="colorOnSurfaceInverse">@color/on_surface_inverse_light</item>
		<item name="colorOutline">@color/outline_light</item>
		<item name="colorOutlineVariant">@color/outline_variant_light</item>

		<!-- OsmAnd roles beyond the M3 set (declared in attrs.xml) -->
		<item name="colorPrimaryPressed">@color/primary_pressed_light</item>
		<item name="colorPrimaryContainerPressed">@color/primary_container_pressed_light</item>
		<item name="colorSurfaceContainerHighestPressed">@color/surface_container_highest_pressed_light</item>
		<item name="colorOnSurfaceTertiary">@color/on_surface_tertiary_light</item>
		<item name="colorOnSurfaceDisabled">@color/on_surface_disabled_light</item>
		<item name="colorOutlineDisabled">@color/outline_disabled_light</item>
		<item name="colorSuccess">@color/success_light</item>
		<item name="colorWarning">@color/warning_light</item>
		<item name="colorSuccessIcon">@color/success_icon_light</item>
		<item name="colorWarningIcon">@color/warning_icon_light</item>
		<item name="colorErrorIcon">@color/error_icon_light</item>
		<item name="scrimBackground">@color/scrim_light</item>

		<item name="colorPrimaryFixed">@color/primary_fixed</item>
		<item name="colorPrimaryFixedDim">@color/primary_fixed_dim</item>
		<item name="colorOnPrimaryFixed">@color/on_primary_fixed</item>
		<item name="colorOnPrimaryFixedVariant">@color/on_primary_fixed_variant</item>
		<item name="colorSecondaryFixed">@color/secondary_fixed</item>
		<item name="colorSecondaryFixedDim">@color/secondary_fixed_dim</item>
		<item name="colorOnSecondaryFixed">@color/on_secondary_fixed</item>
		<item name="colorOnSecondaryFixedVariant">@color/on_secondary_fixed_variant</item>
		<item name="colorTertiaryFixed">@color/tertiary_fixed</item>
		<item name="colorTertiaryFixedDim">@color/tertiary_fixed_dim</item>
		<item name="colorOnTertiaryFixed">@color/on_tertiary_fixed</item>
		<item name="colorOnTertiaryFixedVariant">@color/on_tertiary_fixed_variant</item>

		<!-- AppCompat widgets (check boxes, radio buttons, edit texts) tint from colorAccent,
		     which M3 would otherwise leave on its baseline value -->
		<item name="colorAccent">@color/primary_light</item>
		<item name="colorControlActivated">@color/primary_light</item>

		<item name="materialAlertDialogTheme">@style/ThemeOverlay.OsmAnd.MaterialAlertDialog</item>
	</style>

	<style name="Base.Theme.OsmAnd.Dark" parent="Theme.Material3Expressive.Dark">
		<item name="colorPrimary">@color/primary_dark</item>
		<item name="colorOnPrimary">@color/on_primary_dark</item>
		<item name="colorPrimaryContainer">@color/primary_container_dark</item>
		<item name="colorOnPrimaryContainer">@color/on_primary_container_dark</item>
		<item name="colorPrimaryInverse">@color/primary_inverse_dark</item>
		<item name="colorSecondary">@color/secondary_dark</item>
		<item name="colorOnSecondary">@color/on_secondary_dark</item>
		<item name="colorSecondaryContainer">@color/secondary_container_dark</item>
		<item name="colorOnSecondaryContainer">@color/on_secondary_container_dark</item>
		<item name="colorTertiary">@color/tertiary_dark</item>
		<item name="colorOnTertiary">@color/on_tertiary_dark</item>
		<item name="colorTertiaryContainer">@color/tertiary_container_dark</item>
		<item name="colorOnTertiaryContainer">@color/on_tertiary_container_dark</item>
		<item name="colorError">@color/error_dark</item>
		<item name="colorOnError">@color/on_error_dark</item>
		<item name="colorErrorContainer">@color/error_container_dark</item>
		<item name="colorOnErrorContainer">@color/on_error_container_dark</item>
		<item name="android:colorBackground">@color/surface_dark</item>
		<item name="colorOnBackground">@color/on_surface_dark</item>
		<item name="colorSurface">@color/surface_dark</item>
		<item name="colorOnSurface">@color/on_surface_dark</item>
		<item name="colorSurfaceVariant">@color/surface_variant_dark</item>
		<item name="colorOnSurfaceVariant">@color/on_surface_variant_dark</item>
		<item name="colorSurfaceDim">@color/surface_dim_dark</item>
		<item name="colorSurfaceBright">@color/surface_bright_dark</item>
		<item name="colorSurfaceContainerLowest">@color/surface_container_lowest_dark</item>
		<item name="colorSurfaceContainerLow">@color/surface_container_low_dark</item>
		<item name="colorSurfaceContainer">@color/surface_container_dark</item>
		<item name="colorSurfaceContainerHigh">@color/surface_container_high_dark</item>
		<item name="colorSurfaceContainerHighest">@color/surface_container_highest_dark</item>
		<item name="colorSurfaceInverse">@color/surface_inverse_dark</item>
		<item name="colorOnSurfaceInverse">@color/on_surface_inverse_dark</item>
		<item name="colorOutline">@color/outline_dark</item>
		<item name="colorOutlineVariant">@color/outline_variant_dark</item>

		<!-- OsmAnd roles beyond the M3 set (declared in attrs.xml) -->
		<item name="colorPrimaryPressed">@color/primary_pressed_dark</item>
		<item name="colorPrimaryContainerPressed">@color/primary_container_pressed_dark</item>
		<item name="colorSurfaceContainerHighestPressed">@color/surface_container_highest_pressed_dark</item>
		<item name="colorOnSurfaceTertiary">@color/on_surface_tertiary_dark</item>
		<item name="colorOnSurfaceDisabled">@color/on_surface_disabled_dark</item>
		<item name="colorOutlineDisabled">@color/outline_disabled_dark</item>
		<item name="colorSuccess">@color/success_dark</item>
		<item name="colorWarning">@color/warning_dark</item>
		<item name="colorSuccessIcon">@color/success_icon_dark</item>
		<item name="colorWarningIcon">@color/warning_icon_dark</item>
		<item name="colorErrorIcon">@color/error_icon_dark</item>
		<item name="scrimBackground">@color/scrim_dark</item>

		<item name="colorPrimaryFixed">@color/primary_fixed</item>
		<item name="colorPrimaryFixedDim">@color/primary_fixed_dim</item>
		<item name="colorOnPrimaryFixed">@color/on_primary_fixed</item>
		<item name="colorOnPrimaryFixedVariant">@color/on_primary_fixed_variant</item>
		<item name="colorSecondaryFixed">@color/secondary_fixed</item>
		<item name="colorSecondaryFixedDim">@color/secondary_fixed_dim</item>
		<item name="colorOnSecondaryFixed">@color/on_secondary_fixed</item>
		<item name="colorOnSecondaryFixedVariant">@color/on_secondary_fixed_variant</item>
		<item name="colorTertiaryFixed">@color/tertiary_fixed</item>
		<item name="colorTertiaryFixedDim">@color/tertiary_fixed_dim</item>
		<item name="colorOnTertiaryFixed">@color/on_tertiary_fixed</item>
		<item name="colorOnTertiaryFixedVariant">@color/on_tertiary_fixed_variant</item>

		<!-- AppCompat widgets (check boxes, radio buttons, edit texts) tint from colorAccent,
		     which M3 would otherwise leave on its baseline value -->
		<item name="colorAccent">@color/primary_dark</item>
		<item name="colorControlActivated">@color/primary_dark</item>

		<item name="materialAlertDialogTheme">@style/ThemeOverlay.OsmAnd.MaterialAlertDialog</item>
	</style>

	<!-- M3 dialogs, with the container on the same surface as OsmAnd's list backgrounds so
	     custom dialog content (which paints list_background_color) does not look boxed -->
	<style name="ThemeOverlay.OsmAnd.MaterialAlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
		<item name="alertDialogStyle">@style/MaterialAlertDialog.OsmAnd</item>
	</style>

	<style name="ThemeOverlay.OsmAnd.MaterialAlertDialog.NoAnimation">
		<item name="android:windowAnimationStyle">@null</item>
	</style>

	<style name="MaterialAlertDialog.OsmAnd" parent="MaterialAlertDialog.Material3">
		<item name="backgroundTint">?attr/colorSurfaceContainerLow</item>
	</style>

</resources>
